---
interface Props {
  title: string;
  lang?: 'de' | 'en';
}

const { title, lang = 'de' } = Astro.props;
---

<!DOCTYPE html>
<html lang={lang}>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
</head>
<body>
  <slot />
  
  <div id="bookingModal" class="modal hidden">
    <div class="modal-content">
      <span class="close-btn" onclick="closeBookingModal()">×</span>
      <h2>{lang === 'de' ? 'Booking angefragt' : 'Booking Request'}</h2>
      <p id="modalArtistName"></p>
      <div id="modalButtons" style="display: flex; gap: 12px; margin-top: 20px;">
        <a id="btnEpk" href="#" target="_blank" class="btn btn-primary">{lang === 'de' ? 'EPK ansehen' : 'View EPK'}</a>
        <a id="btnBandcamp" href="#" target="_blank" class="btn btn-outline">{lang === 'de' ? 'Auf Bandcamp' : 'On Bandcamp'}</a>
      </div>
      <p style="margin-top: 20px; font-size: 0.9rem; color: var(--gray);">{lang === 'de' ? 'Deine Mail-App öffnet sich...' : 'Your mail app will open...'}</p>
    </div>
  </div>
  
  <script>
    const currentLang = document.documentElement.lang;
    const langToggle = document.getElementById('langToggle');
    if (langToggle) {
      langToggle.addEventListener('click', () => {
        window.location.href = currentLang === 'en' ? '/' : '/en/';
      });
    }
    
    let currentArtistData = null;
    window.openBookingModal = function(element) {
      const template = element.querySelector('.modal-data');
      if (!template) return;
      try {
        currentArtistData = JSON.parse(template.textContent);
        document.getElementById('modalArtistName').textContent = currentArtistData.ensemble;
        document.getElementById('btnEpk').href = currentArtistData.epk || '#';
        document.getElementById('btnBandcamp').href = currentArtistData.bandcamp || '#';
        document.getElementById('bookingModal').classList.remove('hidden');
      } catch (e) {
        console.error('Error:', e);
      }
    };
    window.closeBookingModal = function() {
      document.getElementById('bookingModal').classList.add('hidden');
    };
    document.getElementById('bookingModal').addEventListener('click', (e) => {
      if (e.target.id === 'bookingModal') closeBookingModal();
    });
    document.querySelectorAll('a[href^="#"]').forEach(anchor => {
      anchor.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    });
  </script>
</body>
</html>
