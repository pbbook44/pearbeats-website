---
import { uiTexts } from '../data/ui-texts';
import { loadArtists } from '../data/loadArtists';

interface Props {
  texts: typeof uiTexts.de;
  lang: 'de' | 'en';
}

const { texts, lang } = Astro.props;
const t = texts.contact;
const artists = await loadArtists();
---

<section id="contact" class="contact">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-info">
        <span class="section-label" style="color: rgba(255,255,255,0.7);">{t.label}</span>
        <h2>{t.title}</h2>
        <p>{t.subtitle}</p>

        <div class="contact-detail">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>{t.email}</span>
        </div>

        <div class="contact-tabs">
          <button 
            type="button"
            class="tab-btn active" 
            id="tab-booking" 
            onclick="switchContactTab('booking')"
          >
            {t.bookingTab}
          </button>
          <button 
            type="button"
            class="tab-btn" 
            id="tab-apply" 
            onclick="switchContactTab('apply')"
          >
            {t.applyTab}
          </button>
        </div>
      </div>

      <div class="contact-form-wrapper">
        <!-- EINZELNES FORMULAR -->
        <form class="contact-form" id="main-contact-form">
          <h3 id="form-title">{t.bookingTitle}</h3>
          
          <div class="form-group">
            <label for="contact-name">{t.name} *</label>
            <input type="text" id="contact-name" name="name" required autocomplete="name" placeholder={t.namePlaceholder} />
          </div>

          <div class="form-row">
            <div class="form-group">
              <label for="contact-email">{t.formEmail} *</label>
              <input type="email" id="contact-email" name="email" required autocomplete="email" placeholder={t.emailPlaceholder} />
            </div>
            <div class="form-group" id="org-field">
              <label for="contact-org">{t.organization}</label>
              <input type="text" id="contact-org" name="organization" autocomplete="organization" placeholder={t.orgPlaceholder} />
            </div>
          </div>

          <!-- Nur für Booking sichtbar -->
          <div class="form-group" id="artist-select-field">
            <label for="contact-artist">{t.selectArtist}</label>
            <select id="contact-artist" name="artist">
              <option value="">{t.anyArtist}</option>
              {artists.map(artist => (
                <option value={artist.ensemble}>{artist.ensemble}</option>
              ))}
              <option value="other">{t.otherArtist}</option>
            </select>
          </div>

          <!-- Felder, die nur bei Bewerbung sichtbar sind -->
          <div class="application-fields" id="application-fields" style="display: none;">
            <div class="form-group">
              <label for="app-size">{t.ensembleSize} *</label>
              <select id="app-size" name="ensemble_size" required>
                <option value="">-- {t.selectSize} --</option>
                <option value="solo">Solo</option>
                <option value="duo">Duo</option>
                <option value="3-7">3-7</option>
                <option value="7-12">7-12</option>
                <option value="12+">&gt;12</option>
              </select>
            </div>

            <div class="form-group">
              <label for="app-social">{t.socialMedia}</label>
              <input type="url" id="app-social" name="social_media" placeholder="https://instagram.com/..." />
            </div>

            <div class="form-group">
              <label for="app-website">{t.website}</label>
              <input type="url" id="app-website" name="website" placeholder="https://..." />
            </div>

            <div class="form-group">
              <label for="app-audio">{t.audioLink}</label>
              <input type="url" id="app-audio" name="audio_link" placeholder="https://bandcamp.com/..." />
            </div>
          </div>

          <div class="form-group">
            <label for="contact-message">{t.formMessage} *</label>
            <textarea id="contact-message" name="message" required placeholder={t.messagePlaceholder}></textarea>
          </div>

          <button type="submit" class="form-submit" id="submit-btn">{t.submit}</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  const mainForm = document.getElementById('main-contact-form');
  const formTitle = document.getElementById('form-title');
  const submitBtn = document.getElementById('submit-btn');
  const bookingTab = document.getElementById('tab-booking');
  const applyTab = document.getElementById('tab-apply');
  const artistSelectField = document.getElementById('artist-select-field');
  const orgField = document.getElementById('org-field');
  const applicationFields = document.getElementById('application-fields');

  // Werte aus dem Frontend lesen (nicht als Strings!)
  const bookingTitleText = document.getElementById('form-title')?.textContent || 'Booking Anfrage';
  const applyTitleText = 'Als Artist bewerben';
  const bookingSubmitText = document.getElementById('submit-btn')?.textContent || 'Anfrage absenden';
  const applySubmitText = 'Bewerbung absenden';

  window.switchContactTab = function(mode) {
    if (mode === 'booking') {
      if (bookingTab) bookingTab.classList.add('active');
      if (applyTab) applyTab.classList.remove('active');
      
      if (formTitle) formTitle.textContent = bookingTitleText;
      if (submitBtn) submitBtn.textContent = bookingSubmitText;
      
      if (artistSelectField) artistSelectField.style.display = '';
      if (orgField) orgField.style.display = '';
      if (applicationFields) applicationFields.style.display = 'none';
    } else {
      if (applyTab) applyTab.classList.add('active');
      if (bookingTab) bookingTab.classList.remove('active');
      
      if (formTitle) formTitle.textContent = applyTitleText;
      if (submitBtn) submitBtn.textContent = applySubmitText;
      
      if (artistSelectField) artistSelectField.style.display = 'none';
      if (orgField) orgField.style.display = 'none';
      if (applicationFields) applicationFields.style.display = '';
    }
  };

  window.selectArtistForBooking = function(artistName) {
    // Modal erst schließen
    const modals = document.querySelectorAll('dialog[open]');
    modals.forEach(modal => modal.close());

    // Auf Booking-Tab setzen
    switchContactTab('booking');
    
    // Dropdown setzen
    const select = document.getElementById('contact-artist');
    if (select) {
      let found = false;
      for (const option of select.options) {
        if (option.value === artistName) {
          option.selected = true;
          found = true;
          break;
        }
      }
      if (!found) select.value = 'other';
    }

    setTimeout(() => {
      const contactSection = document.getElementById('contact');
      if (contactSection) {
        contactSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }, 300);
  };

  if (mainForm) {
    mainForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(mainForm);
      console.log('Form submitted:', Object.fromEntries(formData));
      alert('Anfrage wird gesendet... (API noch nicht verbunden)');
      mainForm.reset();
    });
  }
</script>