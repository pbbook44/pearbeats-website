---
import { uiTexts } from '../data/ui-texts';
const { texts, lang } = Astro.props;
---

<section class="contact" id="contact">
  <div class="container">
    <div class="contact-inner">
      <div class="contact-info">
        <span class="section-label" style="color: var(--pear-pale);">{texts.contact.label}</span>
        <h2>{texts.contact.title}</h2>
        <p>{texts.contact.intro}</p>

        <div class="contact-detail">
          <svg viewBox="0 0 24 24"><path d="M20 4H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2zm0 4l-8 5-8-5V6l8 5 8-5v2z"/></svg>
          <span>{texts.contact.email}</span>
        </div>
        <div class="contact-detail">
          <svg viewBox="0 0 24 24"><path d="M6.62 10.79c1.44 2.83 3.76 5.14 6.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 1.24 0 2.45.2 3.57.57.35.12.75.03 1.02-.24l2.2-2.2z"/></svg>
          <span>{texts.contact.phone}</span>
        </div>
        <div class="contact-detail">
          <svg viewBox="0 0 24 24"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/></svg>
          <span>{texts.contact.location}</span>
        </div>

        <div class="social-links">
          <a href="#" class="social-link" aria-label="Instagram">
            <svg viewBox="0 0 24 24"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8C4 18.39 5.61 20 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6C20 5.61 18.39 4 16.4 4H7.6m9.65 1.5a1.25 1.25 0 0 1 1.25 1.25A1.25 1.25 0 0 1 17.25 8 1.25 1.25 0 0 1 16 6.75a1.25 1.25 0 0 1 1.25-1.25M12 7a5 5 0 0 1 5 5 5 5 0 0 1-5 5 5 5 0 0 1-5-5 5 5 0 0 1 5-5m0 2a3 3 0 0 0-3 3 3 3 0 0 0 3 3 3 3 0 0 0 3-3 3 3 0 0 0-3-3z"/></svg>
          </a>
          <a href="#" class="social-link" aria-label="X / Twitter">
            <svg viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
          </a>
        </div>
      </div>

      <form class="contact-form" onsubmit="event.preventDefault(); alert(lang === 'de' ? 'Danke! Wir melden uns innerhalb von 48 Stunden.' : 'Thank you! We will respond within 48 hours.');">
        <div class="form-row">
          <div class="form-group">
            <label for="name">{texts.contact.formName} *</label>
            <input type="text" id="name" name="name" placeholder={texts.contact.formName} required>
          </div>
          <div class="form-group">
            <label for="email">{texts.contact.formEmail} *</label>
            <input type="email" id="email" name="email" placeholder="ihre@email.de" required>
          </div>
        </div>
        <div class="form-group">
          <label for="type">{texts.contact.formType}</label>
          <select id="formType" name="type">
            <option value="">Bitte wählen…</option>
            {texts.footer.typeOptions.map(option => <option value={option}>{option}</option>)}
          </select>
        </div>
        <div class="form-group">
          <label for="message">{texts.contact.formMessage} *</label>
          <textarea id="message" name="message" placeholder="..." required style="min-height: 120px;"></textarea>
        </div>
        <button type="submit" class="form-submit">{texts.contact.btnSubmit}</button>
      </form>
    </div>
  </div>
</section>