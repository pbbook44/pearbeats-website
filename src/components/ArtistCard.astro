---
import type { Artist } from '../data/loadArtists';
import { uiTexts } from '../data/ui-texts';

interface Props {
  artist: Artist;
  texts: typeof uiTexts.de;
  lang: 'de' | 'en';
}

const { artist, texts, lang } = Astro.props;
const modalId = `artist-modal-${artist.shortname}`;
const safeName = artist.ensemble.replace(/'/g, "\\'");
const t = texts.modal ?? { epkLink: 'EPK', bandcampLink: 'Bandcamp', bookNow: 'Anfragen', close: 'Schließen' };

function extractVideoId(url: string): string | null {
  if (!url) return null;
  const match = url.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/)([^&\s]+)/);
  return match?.[1] ?? null;
}

const videoId = artist.video ? extractVideoId(artist.video) : null;

function normalizeBandcamp(url: string): string {
  if (!url) return '';
  return url.startsWith('http') ? url : `https://${url}`;
}

const bandcampUrl = artist.bandcamp ? normalizeBandcamp(artist.bandcamp) : '';

const hasValidPhoto = artist.photo_url &&
  (artist.photo_url.startsWith('/images/') || (artist.photo_url.startsWith('http') && !artist.photo_url.includes('drive.proton.me')));
---

<article class="artist-card" data-shortname={artist.shortname}>
  <button
    class="card-trigger"
    aria-label={`Details für ${artist.ensemble}`}
    onclick={`document.getElementById('${modalId}').showModal()`}
  >
    <div class="artist-card-image">
      <svg viewBox="0 0 80 80" role="img" aria-hidden="true">
        <circle cx="40" cy="28" r="16" />
        <path d="M12 70c0-16 12-26 28-26s28 10 28 26" />
      </svg>
      {hasValidPhoto && (
        <img src={artist.photo_url} alt="" loading="lazy" style="position:absolute;inset:0;width:100%;height:100%;object-fit:cover;color:transparent;font-size:0;" />
      )}
      {artist.genre && <span class="artist-badge">{artist.genre}</span>}
    </div>

    <div class="artist-card-info">
      <h3>{artist.ensemble}</h3>
      {artist.stadt && <p class="city">{artist.stadt}</p>}
    </div>
  </button>
</article>

<dialog id={modalId} class="artist-detail-modal">
  <form method="dialog">
    <button class="modal-close" aria-label={t.close}>&times;</button>
  </form>

  <div class="modal-body">
    <header class="modal-header">
      <h2>{artist.ensemble}</h2>
      {artist.genre && <span class="modal-genre">{artist.genre}</span>}
    </header>

    {videoId && (
      <div class="modal-video">
        <iframe
          src={`https://www.youtube.com/embed/${videoId}`}
          title={`${artist.ensemble} Video`}
          frameborder="0"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen
        ></iframe>
      </div>
    )}

    <div class="modal-links">
      {artist.epk && (
        <a href={artist.epk} target="_blank" rel="noopener" class="btn btn-secondary">
          {t.epkLink}
        </a>
      )}
      {bandcampUrl && (
        <a href={bandcampUrl} target="_blank" rel="noopener" class="btn btn-secondary">
          {t.bandcampLink}
        </a>
      )}
      <button
        class="btn btn-primary"
        onclick={`document.getElementById('${modalId}').close(); window.selectArtistForBooking('${safeName}');`}
      >
        {t.bookNow}
      </button>
    </div>
  </div>
</dialog>