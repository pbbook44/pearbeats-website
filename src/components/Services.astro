---
import { uiTexts } from '../data/ui-texts';
const { texts } = Astro.props;
---

<section class="services" id="services">
  <div class="container">
    <span class="section-label" data-lang="services.label">{texts.services.label}</span>
    <h2 class="section-title" data-lang="services.title">{texts.services.title}</h2>
    <p class="section-subtitle" data-lang="services.subtitle">{texts.services.subtitle}</p>

    <div class="grid-3 services-grid">
      <div class="card-base service-card">
        <div class="icon-circle">
          <svg viewBox="0 0 24 24"><path d="M12 2L2 7v10c0 5.55 3.84 9.74 9 11 5.16-1.26 9-5.45 9-11V5l-10-5z"/></svg>
        </div>
        <h3 data-lang="services.s1Title">{texts.services.s1Title}</h3>
        <p data-lang="services.s1Desc">{texts.services.s1Desc}</p>
      </div>
      <div class="card-base service-card">
        <div class="icon-circle">
          <svg viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm-7 14l-5-5 1.41-1.41L12 14.17l7.59-7.59L21 8l-9 9z"/></svg>
        </div>
        <h3 data-lang="services.s2Title">{texts.services.s2Title}</h3>
        <p data-lang="services.s2Desc">{texts.services.s2Desc}</p>
      </div>
      <div class="card-base service-card">
        <div class="icon-circle">
          <svg viewBox="0 0 24 24"><path d="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm0 10.99h7c-.53 4.12-3.28 7.79-7 8.94V12H5V6.3l7-3.11v8.8z"/></svg>
        </div>
        <h3 data-lang="services.s3Title">{texts.services.s3Title}</h3>
        <p data-lang="services.s3Desc">{texts.services.s3Desc}</p>
      </div>
    </div>
  </div>
</section>